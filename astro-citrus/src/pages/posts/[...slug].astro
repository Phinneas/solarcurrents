---
import { getPostBySlug, renderPost } from "@/data/post";
import PostLayout from "@/layouts/BlogPost.astro";

const { slug } = Astro.params;
if (!slug) {
	return new Response(null, { status: 404 });
}

// Redirect old pagination URLs (/posts/2/, /posts/3/, etc.) to new structure
if (/^\d+$/.test(slug)) {
	return Astro.redirect(`/posts/page/${slug}/`, 301);
}

const post = await getPostBySlug(slug);

if (!post) {
	return new Response(null, { status: 404 });
}

const { html } = await renderPost(post.body);
---

<PostLayout post={post} headings={post.headings}>
	<Fragment set:html={html} />
</PostLayout>
