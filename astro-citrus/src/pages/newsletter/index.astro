---
import { getAllNewsletters, groupNewslettersByYear } from "@/data/newsletter";
import PageLayout from "@/layouts/Base.astro";
import FormattedDate from "@/components/FormattedDate.astro";

const allNewsletters = await getAllNewsletters();
const groupedByYear = groupNewslettersByYear(allNewsletters);
const descYearKeys = Object.keys(groupedByYear).sort((a, b) => +b - +a);

const meta = {
	description: "Solarpunk Currents — the clean energy transition through a solarpunk lens, delivered weekly.",
	noindex: false,
	title: "Newsletter",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-6">Solarpunk Currents</h1>
	<p class="mb-8 text-lg text-lighter">
		The clean energy transition through a solarpunk lens — community power, climate justice, and imaginative futures.
	</p>
	<section aria-label="Newsletter archive" class="grow">
		{descYearKeys.map((yearKey) => (
			<>
				<h4 class="title">{yearKey}</h4>
				<ul class="mb-8 mt-4 space-y-6">
					{groupedByYear[yearKey]?.map((nl) => (
						<li class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
							<FormattedDate
								class="shrink-0 text-sm text-lighter sm:order-2 sm:text-right"
								date={nl.data.publishDate}
								dateTimeOptions={{ year: "numeric", month: "long", day: "2-digit" }}
							/>
							<div class="sm:order-1">
								<a
									class="citrus-link font-medium text-accent-base"
									data-astro-prefetch
									href={`/newsletter/${nl.id}/`}
								>
									{nl.data.title}
								</a>
								<p class="mt-0.5 line-clamp-2 text-sm">{nl.data.description}</p>
							</div>
						</li>
					))}
				</ul>
			</>
		))}
		{allNewsletters.length === 0 && (
			<p class="text-lighter">No newsletters yet. Check back soon.</p>
		)}
	</section>
</PageLayout>
