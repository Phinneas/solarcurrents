---
import { getNewsletterBySlug, renderNewsletter } from "@/data/newsletter";
import PageLayout from "@/layouts/Base.astro";
import FormattedDate from "@/components/FormattedDate.astro";

const { slug } = Astro.params;
if (!slug) {
	return new Response(null, { status: 404 });
}

const newsletter = await getNewsletterBySlug(slug);

if (!newsletter) {
	return new Response(null, { status: 404 });
}

const { html } = await renderNewsletter(newsletter.body);

const meta = {
	title: newsletter.data.title,
	description: newsletter.data.description,
	articleDate: newsletter.data.publishDate.toISOString(),
};
---

<PageLayout meta={meta}>
	<article class="prose prose-citrus max-w-none">
		<header class="mb-8">
			<FormattedDate
				class="text-sm text-lighter"
				date={newsletter.data.publishDate}
				dateTimeOptions={{ year: "numeric", month: "long", day: "2-digit" }}
			/>
			<h1 class="mt-2 mb-0">{newsletter.data.title}</h1>
			<p class="mt-2 text-lg text-lighter">{newsletter.data.description}</p>
		</header>
		<Fragment set:html={html} />
	</article>
</PageLayout>
