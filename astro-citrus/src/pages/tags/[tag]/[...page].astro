---
import Pagination from "@/components/Paginator.astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import { getPostsByTag } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

const PAGE_SIZE = 10;

const { tag } = Astro.params;
const pageParam = Astro.params.page;

if (!tag) {
	return new Response(null, { status: 404 });
}

const posts = await getPostsByTag(tag);
const sortedPosts = posts.sort(collectionDateSort);

const currentPage = pageParam ? parseInt(pageParam, 10) : 1;
if (isNaN(currentPage) || currentPage < 1) {
	return new Response(null, { status: 404 });
}

const totalPages = Math.ceil(sortedPosts.length / PAGE_SIZE);
if (currentPage > totalPages && totalPages > 0) {
	return new Response(null, { status: 404 });
}

const start = (currentPage - 1) * PAGE_SIZE;
const pagePosts = sortedPosts.slice(start, start + PAGE_SIZE);

const meta = {
	description: `View all posts with the tag - ${tag}`,
	noindex: true,
	title: `Tag: ${tag}`,
};

const paginationProps = {
	...(currentPage > 1 && {
		prevUrl: {
			text: "← Previous Tags",
			url: currentPage === 2 ? `/tags/${tag}/` : `/tags/${tag}/${currentPage - 1}/`,
		},
	}),
	...(currentPage < totalPages && {
		nextUrl: {
			text: "Next Tags →",
			url: `/tags/${tag}/${currentPage + 1}/`,
		},
	}),
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-6 flex items-center">
		<a class="text-accent-two sm:hover:underline" href="/tags/">Tags</a>
		<span class="me-3 ms-2">→</span>
		<span class="text-2xl">#{tag}</span>
	</h1>
	<section aria-label="Blog post list">
		<ul class="space-y-4">
			{
				pagePosts.map((p) => (
					<li class="grid-cols-[auto_1fr]">
						<PostPreview post={p} />
					</li>
				))
			}
		</ul>
		<Pagination {...paginationProps} />
	</section>
</PageLayout>
