---
import { menuLinks, siteConfig } from "@/site.config";

const year = new Date().getFullYear();
---

<footer
	class="mt-auto w-full border-t border-[var(--border)] px-8 pb-4 pt-8"
>
	<div
		class="flex w-full flex-col items-center justify-center gap-y-2 pb-2 text-center align-top sm:flex-row sm:justify-between sm:text-sm"
	>
		<div class="font-['Fraunces'] text-[var(--gold)] sm:me-4">
			{siteConfig.title}
		</div>
		<nav
			aria-label="More on this site"
			class="flex justify-between space-x-4 text-[var(--muted)] md:w-[14rem] w-auto"
		>
			{
				menuLinks.map((link) => (
					<a class="hover:text-[var(--gold)] transition-colors duration-200" href={link.path}>
						{link.title}
					</a>
				))
			}
		</nav>
	</div>
	<div
		class="mt-3 border-t border-[var(--border)] pt-3 text-center text-xs text-[var(--muted)]"
	>
		This site is a product of{" "}
		<a
			class="font-medium text-[var(--gold)] transition-colors duration-200 hover:underline"
			href="https://www.salishseaconsulting.com"
			target="_blank"
			rel="noopener noreferrer"
		>
			Salish Sea Consulting
		</a>
	</div>
</footer>
